# OmniMind 部署到 https://lucky123.cc.cd 的示例。
# 先把 dist 上传到 /var/www/omnimind，并替换证书路径。

server {
    listen 80;
    server_name lucky123.cc.cd;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name lucky123.cc.cd;

    ssl_certificate     /etc/letsencrypt/live/lucky123.cc.cd/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lucky123.cc.cd/privkey.pem;

    root /var/www/omnimind;
    index index.html;

    # API 由前端直接请求 https://api.lucky123.cc.cd，本站不再代理 API。
    # Vue Router history 模式及 OAuth 回跳页需要 SPA fallback。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
