# 生产环境留空时使用当前站点同源的 /api，由 omni Worker 转发到 TokenPortal。
# 仅在需要请求其他 API 域名时填写完整地址。
VITE_API_BASE_URL=

# 使用 omni Worker 时请留空。完整 pk 应保存在 Cloudflare Runtime Secret
# TOKENPORTAL_PK 中，不能写入前端。不要填写 ak-/sk- 密钥。
VITE_TOKENPORTAL_APP_KEY=

# OAuth 应用 ID（应用自身的 id，不是 pk- 后面的 appKeyId）。
# TokenPortal 会用它找到应用域名，并回跳到 <应用域名>/auth/oauth-callback?code=...
VITE_TOKENPORTAL_APP_ID=
# 留空时 OAuth 从当前站点同源的 /api/v1/oauth/... 发起。
VITE_TOKENPORTAL_OAUTH_BASE_URL=
