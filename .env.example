# 前端统一请求自定义 API 域名，由该域名后的 Worker 转发到 TokenPortal。
VITE_API_BASE_URL=https://api.lucky123.cc.cd

# TokenPortal 创建应用/重置 pk 时仅展示一次的完整 Publishable Key。
# 列表页显示的 pk-{appKeyId} 是脱敏值，不能用于请求。不要填写 ak-/sk- 密钥。
VITE_TOKENPORTAL_APP_KEY=

# OAuth 应用 ID（应用自身的 id，不是 pk- 后面的 appKeyId）。
# TokenPortal 会用它找到应用域名，并回跳到 <应用域名>/auth/oauth-callback?code=...
VITE_TOKENPORTAL_APP_ID=
VITE_TOKENPORTAL_OAUTH_BASE_URL=https://api.lucky123.cc.cd
